{
  "info": {
    "name": "Healthcare API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patient",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\",\n  \"email\": \"john@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"role\": \"Patient\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5051",
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5051",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorUsername\": \"drsmith\",\n  \"appointmentDate\": \"2025-11-10T14:00:00Z\",\n  \"reason\": \"Routine check-up\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/appointment/book",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5051",
              "path": [
                "api",
                "appointment",
                "book"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Doctor",
      "item": [
        {
          "name": "Register Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"drsmith\",\n  \"password\": \"StrongPass456!\",\n  \"email\": \"drsmith@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"role\": \"Doctor\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5051",
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"doctor1\",\n  \"password\": \"StrongPass456!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5051",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
