            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientUsername\": \"johndoe\",\n  \"doctorUsername\": \"drsmith\",\n  \"appointmentDate\": \"2025-11-10T14:00:00Z\",\n  \"reason\": \"Routine check-up\"\n}"
        },
        "url": {
