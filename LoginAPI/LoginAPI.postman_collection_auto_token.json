{
  "info": {
    "name": "LoginAPI Collection",
    "description": "Postman collection for LoginAPI endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin1\", \"password\": \"StrongPass456!\"}"
        },
        "auth": null
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"jwtToken\", jsonData.token);",
              "    console.log(\"JWT token set in environment\");",
              "} else {",
              "    console.warn(\"Token not found in response\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"newuser\", \"password\": \"NewPass123!\", \"email\": \"newuser@example.com\", \"firstName\": \"New\", \"lastName\": \"User\", \"role\": \"User\"}"
        }
      }
    },
    {
      "name": "Book Appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/book",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "book"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin1\", \"patientUsername\": \"patient1\", \"doctorUsername\": \"doctor1\", \"reason\": \"Routine checkup\", \"appointmentDate\": \"2025-11-10T10:00:00\", \"status\": 0}"
        }
      }
    },
    {
      "name": "Get My Appointments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/my",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "my"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "Get All Appointments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "all"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "Get Appointments by Username",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/admin1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "admin1"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "Update Appointment Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/status/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "status",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "1"
        }
      }
    },
    {
      "name": "Delete Appointment",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/Appointment/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Appointment",
            "1"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Skip check for Login request",
          "if (pm.info.requestName !== \"Login\" && !pm.environment.get(\"jwtToken\")) {",
          "    throw new Error(\"Missing jwtToken. Please run the Login request first to obtain a token.\");",
          "}"
        ]
      }
    }
  ]
}