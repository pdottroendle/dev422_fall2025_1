{
  "info": {
    "name": "Healthcare API - Full Checklist",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patient",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\",\n  \"email\": \"john@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"role\": \"Patient\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/auth/register",
              "protocol": "http",
              "              "port": "5051",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"SecurePass123!\"\n}"
                       "url": {
              "raw": "http://localhost:5051/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5051",
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"token\", jsonData.token);"
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorUsername\": \"drsmith\",\n  \"appointmentDate\": \"2025-11-10T14:00:00Z\",\n  \"reason\": \"Routine check-up\"\n}"
            },
            "url": {
              "raw": "http://localhost:5051/api/appointment/book",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5051",
              "path": ["api", "appointment", "book"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "token", "value": "" }
  ]
}
